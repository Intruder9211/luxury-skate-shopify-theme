[
  {
    "name": "theme_info",
    "theme_name": "Seed Luxury Jewelry",
    "theme_version": "1.1.0",
    "theme_author": "Antigravity Team",
    "theme_documentation_url": "https://seedjewelry.com",
    "theme_support_url": "https://seedjewelry.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FBFBF9",
        "label": "Page background (Warm Ivory)"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#141414",
        "label": "Text color (Obsidian)"
      },
      {
        "type": "color",
        "id": "primary_accent",
        "default": "#B89C72",
        "label": "Luxury Accent (Champagne Gold)"
      },
      {
        "type": "color",
        "id": "secondary_accent",
        "default": "#F4F3EF",
        "label": "Secondary background (Stone)"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#E8E6E1",
        "label": "Hairline border color"
      },
      {
        "type": "color",
        "id": "sale_badge_color",
        "default": "#B89C72",
        "label": "Accent badge color"
      }
    ]
  },
  {
    "name": "Typography & Layout",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n4",
        "label": "Editorial Heading Font"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Body & UI Font"
      },
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Maximum page width",
        "options": [
          {
            "value": "1360px",
            "label": "Luxury Editorial (1360px)"
          },
          {
            "value": "1440px",
            "label": "Wide (1440px)"
          },
          {
            "value": "1600px",
            "label": "Full Width (1600px)"
          }
        ],
        "default": "1360px"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 16,
        "max": 64,
        "step": 4,
        "unit": "px",
        "label": "Page side margins",
        "default": 32
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 12,
        "step": 1,
        "unit": "px",
        "label": "Subtle border radius",
        "default": 2
      }
    ]
  },
  {
    "name": "Cart Drawer",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_cart_drawer",
        "label": "Enable luxury slide-out cart drawer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Enable complimentary gift note field",
        "default": true
      }
    ]
  }
]