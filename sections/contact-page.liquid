<section class="contact-page-section">
  <!-- Hero Banner -->
  <div class="contact-hero">
    <div class="container">
      <span class="contact-hero__badge">{{ section.settings.badge | default: 'RIDER SUPPORT & CONCIERGE' }}</span>
      <h1 class="contact-hero__title">{{ section.settings.heading | default: 'Get In Touch' }}</h1>
      <p class="contact-hero__subtitle">
        {{ section.settings.subheading | default: 'Have questions regarding custom deck builds, dimensions, orders, or international logistics? Our specialist team is here to assist.' }}
      </p>
    </div>
  </div>

  <div class="container contact-content-wrapper">
    <div class="contact-layout-grid">
      <!-- Left Column: Interactive Contact Form -->
      <div class="contact-form-panel">
        <div class="contact-panel-header">
          <span class="contact-panel-badge">SEND A MESSAGE</span>
          <h2 class="contact-panel-title">Direct Inquiries</h2>
          <p class="contact-panel-desc">Fill out your details below and a gear technician will reply within 24 hours.</p>
        </div>

        {% form 'contact', id: 'StreetRideContactForm', class: 'customer-auth-form contact-form' %}
          {% if form.posted_successfully? %}
            <div class="customer-auth-success" style="margin-bottom: 1.5rem; padding: 1rem 1.25rem;">
              <strong>✓ Message Received!</strong>
              <p style="margin: 0.25rem 0 0; font-size: 0.85rem;">Thank you for reaching out. A StreetRide specialist has received your transmission and will respond promptly.</p>
            </div>
          {% endif %}

          {{ form.errors | default_errors }}

          <div class="customer-form-row">
            <div class="customer-input-group">
              <label for="ContactFormName" class="customer-input-label">Your Name</label>
              <input
                type="text"
                name="contact[name]"
                id="ContactFormName"
                class="customer-input-field"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                placeholder="Alex Vance"
                required
              >
            </div>

            <div class="customer-input-group">
              <label for="ContactFormEmail" class="customer-input-label">Email Address</label>
              <input
                type="email"
                name="contact[email]"
                id="ContactFormEmail"
                class="customer-input-field"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="rider@example.com"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
              >
            </div>
          </div>

          <div class="customer-form-row">
            <div class="customer-input-group">
              <label for="ContactFormPhone" class="customer-input-label">Phone Number (Optional)</label>
              <input
                type="tel"
                name="contact[phone]"
                id="ContactFormPhone"
                class="customer-input-field"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                placeholder="+1 (555) 000-0000"
              >
            </div>

            <div class="customer-input-group">
              <label for="ContactFormTopic" class="customer-input-label">Inquiry Subject</label>
              <select name="contact[subject]" id="ContactFormTopic" class="customer-input-field" style="height: 48px;">
                <option value="Deck Sizing & Recommendations">Deck Sizing & Custom Builds</option>
                <option value="Order Tracking & Logistics">Order Tracking & Logistics</option>
                <option value="Hardware Warranty & Returns">Hardware Warranty & Returns</option>
                <option value="Wholesale & Team Partnerships">Wholesale & Team Partnerships</option>
                <option value="General Question">General Question</option>
              </select>
            </div>
          </div>

          <div class="customer-input-group">
            <label for="ContactFormMessage" class="customer-input-label">Message</label>
            <textarea
              rows="6"
              name="contact[body]"
              id="ContactFormMessage"
              class="customer-input-field"
              placeholder="Tell us about your board setup, dimensions, or inquiry details..."
              style="resize: vertical;"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>

          <div class="customer-submit-wrapper" style="margin-top: 1rem;">
            <button type="submit" class="btn btn-primary customer-submit-btn" style="padding: 1.1rem 2.2rem; font-size: 0.82rem; letter-spacing: 0.14em; text-transform: uppercase;">
              Transmit Message &rarr;
            </button>
          </div>
        {% endform %}
      </div>

      <!-- Right Column: Concierge Info, Workshop Hours & FAQ Quick Links -->
      <div class="contact-info-panel">
        <!-- Direct Channels Card -->
        <div class="contact-card">
          <h3 class="contact-card__title">Direct Channels</h3>
          
          <ul class="contact-card__list">
            <li>
              <div class="contact-card__icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <strong>Support Desk</strong>
                <a href="mailto:{{ section.settings.support_email | default: 'support@streetride.com' }}">{{ section.settings.support_email | default: 'support@streetride.com' }}</a>
              </div>
            </li>

            <li>
              <div class="contact-card__icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <strong>Concierge Line</strong>
                <span>{{ section.settings.support_phone | default: '+1 (800) 555-SKATE' }}</span>
              </div>
            </li>

            <li>
              <div class="contact-card__icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <strong>Design Lab & Logistics</strong>
                <p style="margin:0; color:#888;">{{ section.settings.address | default: '742 Evergreen Skatepark Way, Suite 400, Venice, CA 90291' }}</p>
              </div>
            </li>
          </ul>
        </div>

        <!-- Hours & Response Time Card -->
        <div class="contact-card contact-card--dark">
          <span style="font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: #B89C72; font-weight: 700;">OPERATIONAL HOURS</span>
          <h3 style="color:#ffffff; font-family: var(--font-heading-family); margin: 0.5rem 0 1rem; font-size: 1.2rem;">Rider Dispatch Schedule</h3>
          <p style="color:#a3a3a3; font-size: 0.86rem; line-height: 1.6; margin: 0 0 1rem 0;">
            Monday – Friday: 9:00 AM – 6:00 PM PST<br>
            Saturday: 10:00 AM – 4:00 PM PST<br>
            Sunday: Closed for street sessions
          </p>
          <div style="font-size: 0.78rem; color: #10B981; font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
            <span style="display:inline-block; width:8px; height:8px; border-radius:50%; background:#10B981;"></span>
            Typical response window: Under 4 hours
          </div>
        </div>

        <!-- Quick Help Card -->
        <div class="contact-card" style="background:#FBFBF9; border: 1px dashed #D5D0C5;">
          <h4 style="font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: #141414; margin-bottom: 0.5rem;">Immediate Assistance</h4>
          <p style="font-size: 0.82rem; color: #666; margin-bottom: 1rem; line-height: 1.5;">Check out our customer archive or track existing shipments in real-time.</p>
          <div style="display:flex; gap:0.75rem; flex-wrap:wrap;">
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="btn btn-outline" style="padding: 0.45rem 0.85rem; font-size: 0.72rem; text-transform: uppercase;">
              Account Portal
            </a>
            <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline" style="padding: 0.45rem 0.85rem; font-size: 0.72rem; text-transform: uppercase;">
              Browse Catalog
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-page-section {
    background-color: #F8F7F4;
    padding-bottom: 6rem;
    min-height: 85vh;
  }

  .contact-hero {
    background: #141414;
    color: #ffffff;
    padding: 5.5rem 1.5rem 4.5rem;
    text-align: center;
    border-bottom: 1px solid #262626;
    margin-bottom: 4rem;
  }

  .contact-hero__badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #B89C72;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .contact-hero__title {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 300;
    color: #ffffff;
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .contact-hero__subtitle {
    max-width: 640px;
    margin: 0 auto;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #a3a3a3;
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-form-panel {
    background: #ffffff;
    border: 1px solid #EAE6DE;
    border-radius: 4px;
    padding: 3.5rem 3rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.03);
  }

  .contact-panel-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #F0EEE9;
  }

  .contact-panel-badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #B89C72;
    display: block;
    margin-bottom: 0.5rem;
  }

  .contact-panel-title {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: 1.85rem;
    font-weight: 400;
    color: #141414;
    margin: 0 0 0.5rem 0;
  }

  .contact-panel-desc {
    font-size: 0.88rem;
    color: #666666;
    line-height: 1.5;
    margin: 0;
  }

  .contact-info-panel {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .contact-card {
    background: #ffffff;
    border: 1px solid #EAE6DE;
    border-radius: 4px;
    padding: 2.25rem;
    box-shadow: 0 2px 14px rgba(0, 0, 0, 0.02);
  }

  .contact-card--dark {
    background: #141414;
    border-color: #262626;
    color: #ffffff;
  }

  .contact-card__title {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: 1.3rem;
    font-weight: 400;
    color: #141414;
    margin: 0 0 1.5rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #F0EEE9;
  }

  .contact-card__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-card__list li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .contact-card__icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: #F4F3EF;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #B89C72;
  }

  .contact-card__list strong {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    color: #141414;
    margin-bottom: 0.2rem;
  }

  .contact-card__list a {
    font-size: 0.85rem;
    color: #555555;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .contact-card__list a:hover {
    color: #B89C72;
  }

  .contact-card__list span {
    font-size: 0.85rem;
    color: #555555;
  }

  @media (max-width: 900px) {
    .contact-layout-grid {
      grid-template-columns: 1fr;
    }
    .contact-form-panel {
      padding: 2.25rem 1.5rem;
    }
    .contact-hero {
      padding: 4rem 1rem 3rem;
    }
  }
</style>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Hero Badge",
      "default": "RIDER SUPPORT & CONCIERGE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero Heading",
      "default": "Get In Touch"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Hero Subheading",
      "default": "Have questions regarding custom deck builds, dimensions, orders, or international logistics? Our specialist team is here to assist."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support Email",
      "default": "support@streetride.com"
    },
    {
      "type": "text",
      "id": "support_phone",
      "label": "Support Phone",
      "default": "+1 (800) 555-SKATE"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Physical Address",
      "default": "742 Evergreen Skatepark Way, Suite 400, Venice, CA 90291"
    }
  ]
}
{% endschema %}
