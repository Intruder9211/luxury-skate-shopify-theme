<article class="article-section">
  <!-- Article Header -->
  <header class="article-header">
    <div class="container" style="max-width: 820px;">
      <a href="{{ blog.url }}" class="article-back-link">&larr; Back to {{ blog.title | default: 'The Street Journal' }}</a>

      {% if article.tags.size > 0 %}
        <div class="article-tags">
          {% for tag in article.tags %}
            <span class="article-tag-item">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <h1 class="article-title">{{ article.title }}</h1>

      <div class="article-meta">
        <span class="article-author">By <strong>{{ article.author }}</strong></span>
        <span class="article-divider">&bull;</span>
        <time class="article-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>
        {% if article.comments_enabled? %}
          <span class="article-divider">&bull;</span>
          <a href="#comments" class="article-comments-count">{{ article.comments_count }} Comments</a>
        {% endif %}
      </div>
    </div>
  </header>

  <!-- Featured Hero Image -->
  {% if article.image %}
    <div class="container" style="max-width: 1040px; margin-bottom: 3.5rem;">
      <div class="article-hero-media">
        <img
          src="{{ article.image | image_url: width: 1400 }}"
          alt="{{ article.image.alt | default: article.title | escape }}"
          class="article-hero-img"
          loading="eager"
          width="1200"
          height="650"
        >
      </div>
    </div>
  {% endif %}

  <!-- Article Rich Content Body -->
  <div class="container" style="max-width: 780px;">
    <div class="article-content rte">
      {{ article.content }}
    </div>

    <!-- Article Footer Share & Navigation -->
    <div class="article-footer-bar">
      <div class="article-share">
        <span>Share:</span>
        <a href="https://twitter.com/intent/tweet?text={{ article.title | url_encode }}&url={{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener" class="article-share-btn">X / Twitter</a>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: article.url | url_encode }}" target="_blank" rel="noopener" class="article-share-btn">Facebook</a>
      </div>

      <div class="article-nav">
        {% if blog.previous_article %}
          <a href="{{ blog.previous_article.url }}" class="article-nav-link">&larr; Previous Story</a>
        {% endif %}
        {% if blog.next_article %}
          <a href="{{ blog.next_article.url }}" class="article-nav-link">Next Story &rarr;</a>
        {% endif %}
      </div>
    </div>

    <!-- Comments Section (If Enabled in Admin) -->
    {% if blog.comments_enabled? %}
      <section id="comments" class="article-comments-section">
        <h2 class="article-comments-title">
          Comments ({{ article.comments_count }})
        </h2>

        {% paginate article.comments by 10 %}
          {% if article.comments.size > 0 %}
            <div class="comments-list">
              {% for comment in article.comments %}
                <div class="comment-item">
                  <div class="comment-header">
                    <strong>{{ comment.author }}</strong>
                    <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">
                      {{ comment.created_at | date: '%b %d, %Y' }}
                    </time>
                  </div>
                  <div class="comment-body">
                    {{ comment.content }}
                  </div>
                </div>
              {% endfor %}
            </div>

            {% if paginate.pages > 1 %}
              <div class="customer-pagination">
                {{ paginate | default_pagination }}
              </div>
            {% endif %}
          {% endif %}
        {% endpaginate %}

        <!-- Leave a Comment Form -->
        <div class="comment-form-wrapper">
          <h3>Leave a Thought</h3>

          {% form 'new_comment', article %}
            {{ form.errors | default_errors }}

            {% if form.posted_successfully? %}
              <div class="customer-auth-success" style="margin-bottom: 1.5rem;">
                {% if blog.moderated? %}
                  Comment submitted for editorial approval!
                {% else %}
                  Comment posted successfully!
                {% endif %}
              </div>
            {% endif %}

            <div class="customer-form-row">
              <div class="customer-input-group">
                <label for="CommentAuthor" class="customer-input-label">Name</label>
                <input type="text" name="comment[author]" id="CommentAuthor" class="customer-input-field" value="{{ form.author }}" required>
              </div>
              <div class="customer-input-group">
                <label for="CommentEmail" class="customer-input-label">Email</label>
                <input type="email" name="comment[email]" id="CommentEmail" class="customer-input-field" value="{{ form.email }}" required>
              </div>
            </div>

            <div class="customer-input-group" style="margin-top: 1rem;">
              <label for="CommentBody" class="customer-input-label">Message</label>
              <textarea name="comment[body]" id="CommentBody" rows="5" class="customer-input-field" required>{{ form.body }}</textarea>
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top: 1.5rem; padding: 0.85rem 1.8rem; font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase;">
              Post Comment
            </button>
          {% endform %}
        </div>
      </section>
    {% endif %}
  </div>
</article>

<style>
  .article-section {
    padding: 3rem 0 6rem;
    background-color: #FBFBF9;
  }

  .article-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .article-back-link {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #888888;
    text-decoration: none;
    margin-bottom: 1.5rem;
    display: inline-block;
    transition: color 0.2s ease;
  }

  .article-back-link:hover {
    color: #141414;
  }

  .article-tags {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .article-tag-item {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #B89C72;
  }

  .article-title {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    line-height: 1.25;
    color: #141414;
    margin: 0 0 1.25rem 0;
    letter-spacing: -0.01em;
  }

  .article-meta {
    font-size: 0.85rem;
    color: #666666;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .article-hero-media {
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.06);
    aspect-ratio: 16 / 9;
    background-color: #f4f3ef;
  }

  .article-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .article-content {
    font-size: 1.08rem;
    line-height: 1.85;
    color: #2b2b2b;
  }

  .article-content p {
    margin-bottom: 1.6rem;
  }

  .article-content h2,
  .article-content h3 {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    color: #141414;
    margin: 2.5rem 0 1rem;
    line-height: 1.3;
  }

  .article-content img {
    max-width: 100%;
    height: auto;
    border-radius: 3px;
    margin: 2rem 0;
  }

  .article-content blockquote {
    border-left: 3px solid #B89C72;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #555555;
    font-size: 1.15rem;
  }

  .article-footer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    margin-top: 3rem;
    border-top: 1px solid #EAE6DE;
    border-bottom: 1px solid #EAE6DE;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .article-share {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
  }

  .article-share-btn {
    padding: 0.35rem 0.75rem;
    border: 1px solid #DCD9D1;
    border-radius: 999px;
    font-size: 0.75rem;
    color: #444444;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .article-share-btn:hover {
    background: #141414;
    color: #ffffff;
    border-color: #141414;
  }

  .article-nav {
    display: flex;
    gap: 1.5rem;
  }

  .article-nav-link {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: #141414;
    text-decoration: underline;
  }

  .article-comments-section {
    margin-top: 4rem;
    padding-top: 2rem;
  }

  .article-comments-title {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: 1.6rem;
    margin-bottom: 2rem;
  }

  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .comment-item {
    background: #ffffff;
    border: 1px solid #EAE6DE;
    padding: 1.5rem;
    border-radius: 4px;
  }

  .comment-header {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    margin-bottom: 0.75rem;
    color: #555555;
  }

  .comment-body {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #333333;
  }

  .comment-form-wrapper {
    background: #ffffff;
    border: 1px solid #EAE6DE;
    padding: 2.5rem;
    border-radius: 4px;
  }

  .comment-form-wrapper h3 {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
  }
</style>

{% schema %}
{
  "name": "Article Content",
  "settings": []
}
{% endschema %}
