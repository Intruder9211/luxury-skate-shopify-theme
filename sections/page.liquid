{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

<div class="container" style="padding: 5rem var(--page-margin) 7rem; max-width: 860px;">
  <span style="font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-gold, #B89C72); font-weight: 600; display: block; margin-bottom: 0.75rem;">
    {{ shop.name }}
  </span>
  <h1 style="font-family: var(--font-heading-family); font-weight: 300; margin-bottom: 2rem;">
    {{ page.title }}
  </h1>

  <div class="page-content" style="font-size: 1.05rem; line-height: 1.8; color: #333333;">
    {{ page.content }}
  </div>

  <div style="margin-top: 3.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border, #E8E6E1);">
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline" style="font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.15em;">
      &larr; Back to Products
    </a>
  </div>
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": []
}
{% endschema %}
