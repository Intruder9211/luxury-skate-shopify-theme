<!-- Off-Canvas Left Side Navigation Drawer -->
{% render 'offcanvas-nav-drawer' %}

{% comment %}
  Determine if page has a dark hero section behind the header.
  - Homepage ('index') has hero-banner.
  - Collection page ('collection') has collection-hero.
  Pages without hero (product, cart, search, policy) have white backgrounds,
  so the header MUST be solid white with dark icons to prevent invisible text & overlap!
{% endcomment %}
{% assign is_transparent = false %}
{% if section.settings.enable_transparent %}
  {% if template.name == 'index' or template.name == 'collection' or template.suffix == 'about' or template.suffix == 'about-us' or template.suffix == 'contact' %}
    {% assign is_transparent = true %}
  {% endif %}
{% endif %}

<div
  class="site-header-wrapper{% if is_transparent %} is-transparent{% endif %}{% if section.settings.enable_sticky %} is-sticky{% endif %}"
  style="background-color: {{ section.settings.header_bg | default: '#ffffff' }};"
>
  <div class="container site-header-container">
    <header class="site-header" role="banner">
      <!-- Left: Hamburger Drawer Trigger & Quick Search Trigger -->
      <div class="site-header__left">
        <!-- Hamburger Menu Button -->
        <button type="button" class="site-header__hamburger-btn" data-nav-drawer-toggle aria-label="Open Navigation Menu">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="22" height="22">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12h18M3 6h18M3 18h18"></path>
          </svg>
        </button>

        <!-- Search Text & Icon Trigger -->
        {% if section.settings.enable_search %}
          <button type="button" class="site-header__search-trigger-btn" data-search-trigger aria-label="Search">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-4.35-4.35m1.35-5.65a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <span class="site-header__search-label">Search</span>
          </button>
        {% endif %}
      </div>

      <!-- Center: Refined Seed Brand Logo -->
      <div class="site-header__logo">
        <a href="{{ routes.root_url }}">
          {% if section.settings.logo != blank %}
            <img
              src="{{ section.settings.logo | image_url: width: 400 }}"
              alt="{{ section.settings.logo.alt | default: shop.name | escape }}"
              class="site-header__logo-img site-header__logo--custom"
              width="{{ section.settings.logo_width }}"
              height="auto"
              loading="eager"
            >
          {% elsif section.settings.logo_text != blank %}
            <span class="site-header__logo-text">{{ section.settings.logo_text }}</span>
          {% else %}
            <!-- Seed Signature Emblem & Wordmark (Swaps between white and dark automatically) -->
            <img src="{{ 'seed-logo-white.svg' | asset_url }}" alt="Seed Jewelry" class="site-header__logo-img site-header__logo--white" width="{{ section.settings.logo_width | default: 95 }}" height="auto">
            <img src="{{ 'seed-logo-dark.svg' | asset_url }}" alt="Seed Jewelry" class="site-header__logo-img site-header__logo--dark" width="{{ section.settings.logo_width | default: 95 }}" height="auto">
          {% endif %}
        </a>
      </div>

      <!-- Right: Region Tag, Wishlist (with badge), Account, Shopping Bag -->
      <div class="site-header__actions">
        <!-- Country & Currency Selector Tag -->
        {% if section.settings.show_country_selector %}
          <button type="button" class="site-header__region-tag" data-localization-trigger aria-label="Select Country, Currency & Language">
            {{ localization.country.iso_code }} &bull; {{ localization.country.currency.iso_code }} &bull; {{ localization.language.iso_code | upcase }} &or;
          </button>
        {% endif %}

        <!-- Wishlist Icon with Red Badge '0' (Opens slide-out drawer) -->
        <button type="button" class="site-header__icon-btn" data-wishlist-drawer-toggle aria-label="Wishlist">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
          </svg>
          <span class="site-header__wishlist-count">0</span>
        </button>

        <!-- Account Icon / Profile Avatar -->
        {% if section.settings.enable_account %}
          <a
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            class="site-header__icon-btn{% if customer %} site-header__icon-btn--logged-in{% endif %}"
            aria-label="{% if customer %}Account Profile ({{ customer.first_name | default: customer.email }}){% else %}Sign In to Account{% endif %}"
          >
            {% if customer %}
              <!-- Signed-in Active Profile Avatar with Status Ring -->
              <span class="site-header__logged-in-avatar">
                <span class="site-header__avatar-initials">
                  {% if customer.first_name != blank %}
                    {{ customer.first_name | slice: 0, 1 | upcase }}
                  {% else %}
                    {{ customer.email | slice: 0, 1 | upcase }}
                  {% endif %}
                </span>
                <span class="site-header__avatar-status" title="Logged In"></span>
              </span>
            {% else %}
              <!-- Guest / Default Profile Outline -->
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            {% endif %}
          </a>
        {% endif %}

        <!-- Shopping Bag / Cart -->
        {% if section.settings.enable_cart %}
          <button
            type="button"
            class="site-header__icon-btn"
            {% if settings.enable_cart_drawer %}data-cart-drawer-toggle{% else %}onclick="window.location.href='{{ routes.cart_url }}'"{% endif %}
            aria-label="Shopping Bag"
          >
            <!-- Seed Luxury Minimal Shopping Bag Outline -->
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
            </svg>
            <span class="site-header__cart-count" style="{% if cart.item_count == 0 %}display:none;{% endif %}">
              {{ cart.item_count }}
            </span>
          </button>
        {% endif %}
      </div>
    </header>
  </div>
</div>

<!-- Search Drawer Overlay -->
{% render 'search-drawer' %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Custom Logo Text (if no image)",
      "default": "SEED"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 200,
      "step": 5,
      "default": 95,
      "unit": "px",
      "label": "Custom Logo Width"
    },
    {
      "type": "header",
      "content": "Left Off-Canvas Drawer Menus"
    },
    {
      "type": "text",
      "id": "col1_title",
      "label": "Column 1 Heading",
      "default": "Skateboards & Parts"
    },
    {
      "type": "link_list",
      "id": "collections_menu",
      "label": "Column 1 Menu (Skateboards & Parts)"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 Heading",
      "default": "Gear & Accessories"
    },
    {
      "type": "link_list",
      "id": "gear_menu",
      "label": "Column 2 Menu (Gear & Accessories)"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "About link text",
      "default": "About"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About link target"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Contact link text",
      "default": "Contact Us"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link target"
    },
    {
      "type": "header",
      "content": "Behaviors & Features"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_transparent",
      "label": "Enable transparent navbar over hero sections (Home & Collections)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_search",
      "label": "Enable search button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_account",
      "label": "Enable account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_cart",
      "label": "Enable shopping bag icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "Show country / currency tag",
      "default": true
    },
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header Background Color (for pages without hero)",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
