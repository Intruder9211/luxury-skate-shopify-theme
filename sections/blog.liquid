<section class="blog-section">
  <!-- Hero Banner -->
  <div class="blog-hero">
    <div class="container">
      <span class="blog-hero__badge">{{ section.settings.subheading | default: 'STREETRIDE JOURNAL & DISPATCHES' }}</span>
      <h1 class="blog-hero__title">{{ blog.title | default: 'The Street Journal' }}</h1>
      <p class="blog-hero__subtitle">
        {{ section.settings.description | default: 'Deep dives into board engineering, pro rider interviews, spot guides, and street culture.' }}
      </p>

      <!-- Category Filter Tags -->
      {% if blog.all_tags.size > 0 %}
        <div class="blog-tags-nav">
          <a href="{{ blog.url }}" class="blog-tag-pill{% if current_tags == blank %} is-active{% endif %}">
            All Articles
          </a>
          {% for tag in blog.all_tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="blog-tag-pill{% if current_tags contains tag %} is-active{% endif %}">
              {{ tag }}
            </a>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="container blog-content-wrapper">
    {% paginate blog.articles by 9 %}
      {% if blog.articles.size > 0 %}
        <div class="blog-grid">
          {% for article in blog.articles %}
            <article class="blog-card">
              <a href="{{ article.url }}" class="blog-card__image-link">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 800 }}"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    class="blog-card__img"
                    loading="lazy"
                    width="600"
                    height="400"
                  >
                {% else %}
                  <div class="blog-card__img-placeholder">
                    <span>StreetRide Journal</span>
                  </div>
                {% endif %}
                <span class="blog-card__date-badge">
                  {{ article.published_at | date: '%b %d, %Y' }}
                </span>
              </a>

              <div class="blog-card__body">
                {% if article.tags.size > 0 %}
                  <div class="blog-card__tags">
                    {% for tag in article.tags limit: 2 %}
                      <span class="blog-card__tag">{{ tag }}</span>
                    {% endfor %}
                  </div>
                {% endif %}

                <h2 class="blog-card__title">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h2>

                <p class="blog-card__excerpt">
                  {{ article.excerpt_or_content | strip_html | truncatewords: 24 }}
                </p>

                <div class="blog-card__footer">
                  <span class="blog-card__author">By {{ article.author | default: 'StreetRide Team' }}</span>
                  <a href="{{ article.url }}" class="blog-card__read-link">
                    Read Article &rarr;
                  </a>
                </div>
              </div>
            </article>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="customer-pagination" style="margin-top: 4rem;">
            {{ paginate | default_pagination }}
          </div>
        {% endif %}
      {% else %}
        <!-- Editorial Preview when no articles are yet created in admin -->
        <div class="blog-empty-state">
          <span style="font-size: 0.72rem; letter-spacing: 0.2em; text-transform: uppercase; color: #B89C72; font-weight: 700;">EDITORIAL SPOTLIGHT</span>
          <h2>Stories Dropping Soon</h2>
          <p>Our editorial team is crafting technical gear breakdowns, street dispatches, and rider interviews.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="margin-top: 1.5rem;">
            Browse Skateboard Collection
          </a>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

<style>
  .blog-section {
    padding-bottom: 6rem;
    background-color: #FBFBF9;
    min-height: 80vh;
  }

  .blog-hero {
    background: #141414;
    color: #ffffff;
    padding: 5rem 1.5rem 4rem;
    text-align: center;
    border-bottom: 1px solid #262626;
    margin-bottom: 4rem;
  }

  .blog-hero__badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #B89C72;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .blog-hero__title {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    font-weight: 300;
    color: #ffffff;
    margin: 0 0 1rem 0;
    letter-spacing: -0.01em;
  }

  .blog-hero__subtitle {
    max-width: 620px;
    margin: 0 auto;
    font-size: 0.95rem;
    line-height: 1.6;
    color: #a3a3a3;
  }

  .blog-tags-nav {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .blog-tag-pill {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #e5e5e5;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .blog-tag-pill:hover,
  .blog-tag-pill.is-active {
    background-color: #ffffff;
    color: #141414;
    border-color: #ffffff;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .blog-card {
    background: #ffffff;
    border: 1px solid #EAE6DE;
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .blog-card__image-link {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #f4f3ef;
  }

  .blog-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .blog-card:hover .blog-card__img {
    transform: scale(1.06);
  }

  .blog-card__img-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.82rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #8c827a;
    background: linear-gradient(135deg, #1f1f1f 0%, #2b2b2b 100%);
  }

  .blog-card__date-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(20, 20, 20, 0.85);
    backdrop-filter: blur(4px);
    color: #ffffff;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.65rem;
    border-radius: 2px;
    text-transform: uppercase;
  }

  .blog-card__body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-card__tags {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
  }

  .blog-card__tag {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #B89C72;
  }

  .blog-card__title {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.35;
    margin: 0 0 0.75rem 0;
  }

  .blog-card__title a {
    color: #141414;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-card__title a:hover {
    color: #B89C72;
  }

  .blog-card__excerpt {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #666666;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .blog-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid #F0EEE9;
    font-size: 0.78rem;
  }

  .blog-card__author {
    color: #888888;
  }

  .blog-card__read-link {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #141414;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .blog-card__read-link:hover {
    color: #B89C72;
  }

  .blog-empty-state {
    text-align: center;
    padding: 5rem 1.5rem;
    background: #ffffff;
    border: 1px dashed #DCD9D1;
    border-radius: 4px;
    max-width: 650px;
    margin: 0 auto;
  }

  .blog-empty-state h2 {
    font-family: var(--font-heading-family, "Playfair Display", serif);
    font-size: 2rem;
    margin: 0.75rem 0;
  }

  .blog-empty-state p {
    color: #666666;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 990px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.75rem;
    }
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
    .blog-hero {
      padding: 4rem 1rem 3rem;
    }
  }
</style>

{% schema %}
{
  "name": "Blog Grid",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "STREETRIDE JOURNAL & DISPATCHES"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Deep dives into board engineering, pro rider interviews, spot guides, and street culture."
    }
  ]
}
{% endschema %}
