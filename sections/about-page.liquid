<section class="about-hero" style="position: relative; min-height: 52vh; display: flex; align-items: center; justify-content: center; text-align: center; background: linear-gradient(180deg, #181818 0%, #0d0d0d 100%); padding: 9rem var(--page-margin) 4rem; overflow: hidden;">
  <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at center, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.7) 100%);"></div>
  <div style="position: relative; z-index: 2; max-width: 820px; margin: 0 auto;">
    <span style="font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.28em; font-weight: 600; color: var(--color-gold, #B89C72); margin-bottom: 1rem; display: block;">
      {{ section.settings.subheading | default: 'The StreetRide Story' }}
    </span>
    <h1 style="color: #ffffff; font-family: var(--font-heading-family); font-size: clamp(2.4rem, 5vw, 4rem); font-weight: 300; line-height: 1.15; margin-bottom: 1.5rem;">
      {{ section.settings.heading | default: 'Crafted for Speed. Built for the Streets.' }}
    </h1>
    <p style="color: #e2e8f0; font-size: 1.1rem; line-height: 1.7; max-width: 680px; margin: 0 auto; font-weight: 300;">
      {{ section.settings.intro | default: 'From custom-pressed 7-ply Canadian maple decks to ultra-low friction ceramic bearings, we engineer precision skate gear built by riders, for riders.' }}
    </p>
  </div>
</section>

<div class="container" style="padding: 6rem var(--page-margin); max-width: 1000px;">
  <!-- Narrative Section 1 -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; margin-bottom: 6rem;">
    <div>
      <span style="font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-gold, #B89C72); font-weight: 600; display: block; margin-bottom: 0.75rem;">
        01 / Our Foundation
      </span>
      <h2 style="font-size: 2.2rem; font-family: var(--font-heading-family); font-weight: 400; margin-bottom: 1.25rem;">
        Obsession With Precision
      </h2>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #444444; margin-bottom: 1.5rem;">
        StreetRide was founded with one singular focus: elevating everyday skateboarding hardware to architectural standards. Every complete skateboard, cruiser, and component in our catalog is engineered to endure street impacts, ramp transitions, and relentless daily sessions.
      </p>
      <p style="font-size: 1.05rem; line-height: 1.8; color: #444444;">
        We source responsibly harvested Canadian maple, cold-press each ply with proprietary water-resistant resin, and calibrate trucks to the millimeter for responsive turning geometry.
      </p>
    </div>
    <div style="background-color: #f4f3ef; border-radius: var(--border-radius); overflow: hidden; aspect-ratio: 4/5; display: flex; align-items: center; justify-content: center;">
      <img src="{{ 'SR-001.png' | asset_url }}" alt="StreetRide Deck Craftsmanship" width="600" height="750" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy">
    </div>
  </div>

  <!-- Narrative Section 2: Values Grid -->
  <div style="background-color: #f7f6f2; border-radius: 4px; padding: 4rem 3rem; margin-bottom: 6rem;">
    <div style="text-align: center; max-width: 600px; margin: 0 auto 3rem;">
      <span style="font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--color-gold, #B89C72); font-weight: 600; display: block; margin-bottom: 0.5rem;">
        02 / Core Pillars
      </span>
      <h2 style="font-size: 2rem; font-family: var(--font-heading-family); font-weight: 400;">The StreetRide Standard</h2>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem;">
      <div style="background: #ffffff; padding: 2.5rem 2rem; border-radius: 2px; border: 1px solid #e8e6e1;">
        <div style="font-size: 1.6rem; color: var(--color-gold, #B89C72); font-weight: 300; margin-bottom: 1rem;">01</div>
        <h3 style="font-size: 1.15rem; font-family: var(--font-heading-family); margin-bottom: 0.75rem;">7-Ply Canadian Maple</h3>
        <p style="font-size: 0.92rem; color: #666666; line-height: 1.6;">Cold-pressed under high pressure for unmatched pop, stiffness, and durability on streets and ramps.</p>
      </div>

      <div style="background: #ffffff; padding: 2.5rem 2rem; border-radius: 2px; border: 1px solid #e8e6e1;">
        <div style="font-size: 1.6rem; color: var(--color-gold, #B89C72); font-weight: 300; margin-bottom: 1rem;">02</div>
        <h3 style="font-size: 1.15rem; font-family: var(--font-heading-family); margin-bottom: 0.75rem;">ABEC-9 & Ceramic</h3>
        <p style="font-size: 0.92rem; color: #666666; line-height: 1.6;">Ultra-smooth bearings inspected for zero-chatter rotation, long coasting distance, and grit resistance.</p>
      </div>

      <div style="background: #ffffff; padding: 2.5rem 2rem; border-radius: 2px; border: 1px solid #e8e6e1;">
        <div style="font-size: 1.6rem; color: var(--color-gold, #B89C72); font-weight: 300; margin-bottom: 1rem;">03</div>
        <h3 style="font-size: 1.15rem; font-family: var(--font-heading-family); margin-bottom: 0.75rem;">Rider Tested</h3>
        <p style="font-size: 0.92rem; color: #666666; line-height: 1.6;">Every batch of wheels, trucks, and decks is road-tested across abrasive street concrete and bowl transitions.</p>
      </div>
    </div>
  </div>

  <!-- Narrative Section 3: Call to Action -->
  <div style="text-align: center; max-width: 650px; margin: 0 auto; padding-top: 1rem;">
    <h2 style="font-size: 2.4rem; font-family: var(--font-heading-family); font-weight: 400; margin-bottom: 1.25rem;">
      Ready to Build Your Setup?
    </h2>
    <p style="font-size: 1.05rem; color: #666666; line-height: 1.7; margin-bottom: 2.5rem;">
      Explore our complete 64-product catalog of boards, decks, wheels, and protective gear.
    </p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="padding: 1.1rem 2.5rem; font-size: 0.85rem; letter-spacing: 0.16em; text-transform: uppercase;">
      Explore Full Catalog
    </a>
  </div>
</div>

{% schema %}
{
  "name": "About Us Page",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Hero Subheading",
      "default": "The StreetRide Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Hero Heading",
      "default": "Crafted for Speed. Built for the Streets."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Hero Intro",
      "default": "From custom-pressed 7-ply Canadian maple decks to ultra-low friction ceramic bearings, we engineer precision skate gear built by riders, for riders."
    }
  ]
}
{% endschema %}
