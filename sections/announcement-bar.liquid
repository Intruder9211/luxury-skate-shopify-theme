<div class="announcement-bar"{% unless section.settings.enable_announcement %} style="display:none;"{% endunless %}>
  <div class="container announcement-bar__content">
    {% if section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="announcement-bar__link">
        <span>{{ section.settings.text }}</span>
      </a>
    {% else %}
      <span>{{ section.settings.text }}</span>
    {% endif %}
  </div>
</div>

{% style %}
  .announcement-bar {
    background-color: {{ section.settings.bg_color | default: '#1e332a' }};
    color: {{ section.settings.text_color | default: '#e5e9e7' }};
    font-size: {{ section.settings.font_size | default: 13 }}px;
    letter-spacing: 0.05em;
    padding: 0.65rem var(--page-margin);
    text-align: center;
    position: relative;
    z-index: 102;
    transition: all 0.3s ease;
  }
  .announcement-bar__link {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .announcement-bar__link:hover {
    opacity: 0.85;
    text-decoration: underline;
  }
{% endstyle %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Enable announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "Celebrating our launch: 20% off every piece until 30 November."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link (optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1e332a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#e5e9e7"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 13
    }
  ]
}
{% endschema %}
