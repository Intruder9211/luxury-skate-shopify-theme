{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>StreetRide Digital Gift Card - {{ gift_card.balance | money }}</title>

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <style>
      body {
        background-color: #F8F7F4;
        color: #141414;
        font-family: var(--font-primary--family, sans-serif);
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem 1rem;
        margin: 0;
      }

      .giftcard-container {
        max-width: 520px;
        width: 100%;
        background: #ffffff;
        border: 1px solid #E5E1D8;
        border-radius: 6px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        text-align: center;
      }

      .giftcard-header {
        background: #141414;
        color: #ffffff;
        padding: 2.5rem 1.5rem 3.5rem;
        position: relative;
      }

      .giftcard-brand-badge {
        font-size: 0.68rem;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: #B89C72;
        font-weight: 700;
        margin-bottom: 0.5rem;
        display: block;
      }

      .giftcard-brand-title {
        font-family: var(--font-heading-family, serif);
        font-size: 1.8rem;
        margin: 0 0 0.5rem 0;
        font-weight: 400;
        color: #ffffff;
      }

      .giftcard-card-graphic {
        position: relative;
        margin: -2.5rem auto 1.5rem;
        width: 85%;
        max-width: 380px;
        aspect-ratio: 1.58 / 1;
        background: linear-gradient(135deg, #1c1c1c 0%, #2e2a24 100%);
        border: 1px solid #B89C72;
        border-radius: 8px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        color: #ffffff;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        text-align: left;
      }

      .giftcard-chip {
        width: 36px;
        height: 26px;
        background: linear-gradient(135deg, #d4af37 0%, #aa820a 100%);
        border-radius: 4px;
      }

      .giftcard-card-balance {
        font-family: var(--font-heading-family, serif);
        font-size: 2.2rem;
        font-weight: 400;
        color: #F7E9CE;
      }

      .giftcard-body {
        padding: 1.5rem 2.25rem 2.5rem;
      }

      .giftcard-code-wrapper {
        background-color: #F8F7F4;
        border: 1px dashed #C8C2B5;
        border-radius: 4px;
        padding: 1rem;
        margin: 1.5rem 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .giftcard-code-text {
        font-family: monospace;
        font-size: 1.25rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        color: #141414;
      }

      .giftcard-copy-btn {
        background-color: #141414;
        color: #ffffff;
        border: none;
        padding: 0.5rem 1rem;
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        border-radius: 2px;
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .giftcard-copy-btn:hover {
        background-color: #B89C72;
      }

      .giftcard-instructions {
        font-size: 0.88rem;
        color: #666666;
        line-height: 1.6;
        margin-bottom: 2rem;
      }

      .giftcard-shop-btn {
        display: inline-block;
        width: 100%;
        background-color: #141414;
        color: #ffffff;
        padding: 1rem 1.5rem;
        font-size: 0.82rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        text-decoration: none;
        font-weight: 600;
        border-radius: 2px;
        transition: background-color 0.2s ease;
      }

      .giftcard-shop-btn:hover {
        background-color: #B89C72;
      }

      .giftcard-status {
        display: inline-block;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1rem;
      }

      .giftcard-status--active {
        background: #EEF8F1;
        color: #1C6B3E;
      }

      .giftcard-status--disabled {
        background: #FEE2E2;
        color: #991B1B;
      }
    </style>

    {{ content_for_header }}
  </head>

  <body>
    <div class="giftcard-container">
      <div class="giftcard-header">
        <span class="giftcard-brand-badge">OFFICIAL STORE VALUE</span>
        <h1 class="giftcard-brand-title">{{ shop.name | default: 'StreetRide' }}</h1>
        <p style="margin: 0; font-size: 0.85rem; color: #a3a3a3;">Digital Gift Certificate</p>
      </div>

      <!-- Luxury Card Graphic -->
      <div class="giftcard-card-graphic">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div class="giftcard-chip"></div>
          <span style="font-size: 0.75rem; letter-spacing: 0.15em; color: #B89C72; font-weight: 600;">STREETRIDE ARCHIVE</span>
        </div>
        <div>
          <span style="font-size: 0.7rem; letter-spacing: 0.1em; color: #a3a3a3; text-transform: uppercase;">Available Balance</span>
          <div class="giftcard-card-balance">{{ gift_card.balance | money }}</div>
        </div>
      </div>

      <div class="giftcard-body">
        {% if gift_card.enabled == false or gift_card.expired %}
          <div class="giftcard-status giftcard-status--disabled">Expired or Inactive</div>
        {% else %}
          <div class="giftcard-status giftcard-status--active">Active &bull; Ready to Redeem</div>
        {% endif %}

        <div class="giftcard-code-wrapper">
          <span class="giftcard-code-text" id="GiftCardCode">{{ gift_card.code | format_code }}</span>
          <button type="button" class="giftcard-copy-btn" onclick="copyGiftCardCode()">Copy</button>
        </div>

        <p class="giftcard-instructions">
          Apply this redemption code during checkout to deduct value from your skateboard gear, decks, or apparel purchases.
        </p>

        {% if gift_card.pass_url %}
          <div style="margin-bottom: 1.5rem;">
            <a href="{{ gift_card.pass_url }}">
              <img
                src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
                alt="Add to Apple Wallet"
                width="160"
                height="48"
              >
            </a>
          </div>
        {% endif %}

        <a href="{{ shop.url }}" class="giftcard-shop-btn">
          Explore StreetRide Store &rarr;
        </a>
      </div>
    </div>

    <script>
      function copyGiftCardCode() {
        const text = '{{ gift_card.code }}';
        navigator.clipboard.writeText(text).then(() => {
          const btn = document.querySelector('.giftcard-copy-btn');
          btn.textContent = 'Copied!';
          setTimeout(() => { btn.textContent = 'Copy'; }, 2000);
        });
      }
    </script>
  </body>
</html>
