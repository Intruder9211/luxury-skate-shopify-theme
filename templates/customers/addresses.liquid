<section class="customer-account-section">
  <div class="customer-account-container">
    <div class="customer-account-header">
      <div>
        <a href="{{ routes.account_url }}" class="customer-back-link">← Back to Account Overview</a>
        <h1 class="customer-welcome-title" style="margin-top: 0.5rem;">Address Book</h1>
        <p class="customer-account-email">Manage your shipping destinations and billing records</p>
      </div>
      <div>
        <button type="button" class="btn btn-primary" onclick="document.getElementById('AddAddressForm').style.display='block'; window.scrollTo({top: document.getElementById('AddAddressForm').offsetTop - 100, behavior: 'smooth'});">
          + Add New Address
        </button>
      </div>
    </div>

    <!-- Add New Address Form Modal/Panel (Hidden by default) -->
    <div id="AddAddressForm" class="customer-address-form-box" style="display: none; margin-bottom: 3rem;">
      <div class="customer-panel-header">
        <h2 class="customer-panel-title">Add New Delivery Address</h2>
        <button type="button" class="customer-panel-close-btn" onclick="document.getElementById('AddAddressForm').style.display='none';">✕</button>
      </div>

      {% form 'customer_address', customer.new_address, class: 'customer-auth-form' %}
        <div class="customer-form-row">
          <div class="customer-input-group">
            <label for="AddressFirstNameNew" class="customer-input-label">First Name</label>
            <input type="text" id="AddressFirstNameNew" name="address[first_name]" value="{{ form.first_name }}" class="customer-input-field" required>
          </div>
          <div class="customer-input-group">
            <label for="AddressLastNameNew" class="customer-input-label">Last Name</label>
            <input type="text" id="AddressLastNameNew" name="address[last_name]" value="{{ form.last_name }}" class="customer-input-field" required>
          </div>
        </div>

        <div class="customer-input-group">
          <label for="AddressCompanyNew" class="customer-input-label">Company (Optional)</label>
          <input type="text" id="AddressCompanyNew" name="address[company]" value="{{ form.company }}" class="customer-input-field">
        </div>

        <div class="customer-input-group">
          <label for="AddressAddress1New" class="customer-input-label">Address Line 1</label>
          <input type="text" id="AddressAddress1New" name="address[address1]" value="{{ form.address1 }}" class="customer-input-field" required>
        </div>

        <div class="customer-input-group">
          <label for="AddressAddress2New" class="customer-input-label">Apartment, Suite, Unit (Optional)</label>
          <input type="text" id="AddressAddress2New" name="address[address2]" value="{{ form.address2 }}" class="customer-input-field">
        </div>

        <div class="customer-form-row">
          <div class="customer-input-group">
            <label for="AddressCityNew" class="customer-input-label">City</label>
            <input type="text" id="AddressCityNew" name="address[city]" value="{{ form.city }}" class="customer-input-field" required>
          </div>
          <div class="customer-input-group">
            <label for="AddressZipNew" class="customer-input-label">Postal / Zip Code</label>
            <input type="text" id="AddressZipNew" name="address[zip]" value="{{ form.zip }}" class="customer-input-field" required>
          </div>
        </div>

        <div class="customer-form-row">
          <div class="customer-input-group">
            <label for="AddressCountryNew" class="customer-input-label">Country</label>
            <select id="AddressCountryNew" name="address[country]" data-default="{{ form.country }}" class="customer-input-field">
              {{ all_country_option_tags }}
            </select>
          </div>
          <div class="customer-input-group">
            <label for="AddressPhoneNew" class="customer-input-label">Phone Number</label>
            <input type="tel" id="AddressPhoneNew" name="address[phone]" value="{{ form.phone }}" class="customer-input-field">
          </div>
        </div>

        <div class="customer-checkbox-group" style="margin: 0.5rem 0;">
          {{ form.set_as_default_checkbox }}
          <label for="address_default_address_new" style="font-size: 0.85rem; color: #444444; margin-left: 0.5rem;">
            Set as default delivery address
          </label>
        </div>

        <div class="customer-form-actions" style="display: flex; gap: 1rem;">
          <button type="submit" class="btn btn-primary customer-submit-btn" style="width: auto;">
            Save Address
          </button>
          <button type="button" class="btn btn-secondary" onclick="document.getElementById('AddAddressForm').style.display='none';">
            Cancel
          </button>
        </div>
      {% endform %}
    </div>

    <!-- Address Cards Grid -->
    {% paginate customer.addresses by 6 %}
      <div class="customer-addresses-grid">
        {% for address in customer.addresses %}
          <div class="customer-address-card{% if address == customer.default_address %} is-default{% endif %}">
            <div class="customer-address-card-header">
              <span class="customer-address-title">
                {{ address.first_name }} {{ address.last_name }}
              </span>
              {% if address == customer.default_address %}
                <span class="badge badge-default-address">Default</span>
              {% endif %}
            </div>

            <div class="customer-address-card-body">
              {% if address.company != blank %}
                <p>{{ address.company }}</p>
              {% endif %}
              <p>{{ address.street }}</p>
              <p>{{ address.city }}, {{ address.province_code }} {{ address.zip }}</p>
              <p>{{ address.country }}</p>
              {% if address.phone != blank %}
                <p class="customer-address-phone">{{ address.phone }}</p>
              {% endif %}
            </div>

            <div class="customer-address-card-footer">
              <button
                type="button"
                class="btn btn-outline"
                style="padding: 0.45rem 0.85rem; font-size: 0.75rem;"
                onclick="document.getElementById('EditAddress_{{ address.id }}').style.display='block';"
              >
                Edit
              </button>
              <form
                method="post"
                action="/account/addresses/{{ address.id }}"
                onsubmit="return confirm('Are you sure you want to delete this address?');"
                style="display: inline;"
              >
                <input type="hidden" name="_method" value="delete">
                <button type="submit" class="customer-address-delete-btn">
                  Delete
                </button>
              </form>
            </div>

            <!-- Edit Modal / Form Inline -->
            <div id="EditAddress_{{ address.id }}" class="customer-address-form-box" style="display: none; margin-top: 1.5rem;">
              {% form 'customer_address', address, class: 'customer-auth-form' %}
                <div class="customer-form-row">
                  <div class="customer-input-group">
                    <label class="customer-input-label">First Name</label>
                    <input type="text" name="address[first_name]" value="{{ form.first_name }}" class="customer-input-field" required>
                  </div>
                  <div class="customer-input-group">
                    <label class="customer-input-label">Last Name</label>
                    <input type="text" name="address[last_name]" value="{{ form.last_name }}" class="customer-input-field" required>
                  </div>
                </div>

                <div class="customer-input-group">
                  <label class="customer-input-label">Address 1</label>
                  <input type="text" name="address[address1]" value="{{ form.address1 }}" class="customer-input-field" required>
                </div>

                <div class="customer-form-row">
                  <div class="customer-input-group">
                    <label class="customer-input-label">City</label>
                    <input type="text" name="address[city]" value="{{ form.city }}" class="customer-input-field" required>
                  </div>
                  <div class="customer-input-group">
                    <label class="customer-input-label">Postal / Zip</label>
                    <input type="text" name="address[zip]" value="{{ form.zip }}" class="customer-input-field" required>
                  </div>
                </div>

                <div class="customer-checkbox-group" style="margin: 0.5rem 0;">
                  {{ form.set_as_default_checkbox }}
                  <label for="address_default_address_{{ address.id }}" style="font-size: 0.85rem; color: #444444; margin-left: 0.5rem;">
                    Set as default address
                  </label>
                </div>

                <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
                  <button type="submit" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.75rem;">
                    Save
                  </button>
                  <button type="button" class="btn btn-secondary" style="padding: 0.5rem 1rem; font-size: 0.75rem;" onclick="document.getElementById('EditAddress_{{ address.id }}').style.display='none';">
                    Cancel
                  </button>
                </div>
              {% endform %}
            </div>
          </div>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <div class="customer-pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

