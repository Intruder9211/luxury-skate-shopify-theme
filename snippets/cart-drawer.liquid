{% comment %}
  Slide-out AJAX Cart Drawer snippet
{% endcomment %}

<div id="CartDrawer" class="cart-drawer" aria-modal="true" role="dialog" aria-label="Shopping Cart">
  <div class="cart-drawer__overlay"></div>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h2>Your Cart</h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="Close cart">&times;</button>
    </div>

    <div class="cart-drawer__body" id="CartDrawerItems">
      {% if cart.item_count == 0 %}
        <div class="cart-drawer__empty">
          <p>Your cart is empty.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary" style="margin-top:1rem;">Continue Shopping</a>
        </div>
      {% else %}
        <ul class="cart-drawer__items">
          {% for item in cart.items %}
            <li class="cart-drawer__item">
              {% if item.image %}
                <img src="{{ item.image | image_url: width: 160 }}" class="cart-drawer__item-img" alt="{{ item.title | escape }}" loading="lazy" width="80" height="80">
              {% else %}
                <div class="cart-drawer__item-img"></div>
              {% endif %}
              <div>
                <div class="cart-drawer__item-title">{{ item.product.title }}</div>
                {% unless item.product.has_only_default_variant %}
                  <div class="cart-drawer__item-variant">{{ item.variant.title }}</div>
                {% endunless %}
                <div style="font-weight:600;">{{ item.final_line_price | money }}</div>
                <div class="cart-drawer__item-actions">
                  <div class="quantity-control">
                    <button type="button" class="quantity-btn" data-cart-action="decrement" data-line-key="{{ item.key }}" data-qty="{{ item.quantity }}">-</button>
                    <input type="text" class="quantity-input" value="{{ item.quantity }}" readonly aria-label="Quantity">
                    <button type="button" class="quantity-btn" data-cart-action="increment" data-line-key="{{ item.key }}" data-qty="{{ item.quantity }}">+</button>
                  </div>
                  <button type="button" class="cart-drawer__item-remove" data-cart-action="remove" data-line-key="{{ item.key }}">Remove</button>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>

    <div class="cart-drawer__footer" style="{% if cart.item_count == 0 %}display:none;{% endif %}">
      <!-- Discount / Gift Card Coupon Code Input -->
      <div class="cart-drawer__coupon-box" style="margin-bottom: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid #EAE8E2;">
        <label for="CartDrawerDiscountCode" style="display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #141414; margin-bottom: 0.4rem;">
          Discount Code or Gift Card
        </label>
        <div style="display: flex; gap: 0.5rem;">
          <input
            type="text"
            id="CartDrawerDiscountCode"
            placeholder="e.g. STREET20 or Gift Card"
            style="flex: 1; padding: 0.65rem 0.85rem; font-size: 0.82rem; border: 1px solid #DCD9D1; background: #FAFAFA; border-radius: 2px; text-transform: uppercase; outline: none;"
          >
          <button
            type="button"
            id="ApplyDiscountBtn"
            class="btn btn-outline"
            style="padding: 0.65rem 1rem; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;"
            onclick="applyDrawerDiscount()"
          >
            Apply
          </button>
        </div>
        <div id="DrawerDiscountAppliedMsg" style="display: none; font-size: 0.78rem; color: #1C6B3E; margin-top: 0.4rem;">
          ✓ Code ready! It will be automatically applied at checkout.
        </div>
      </div>

      <div class="cart-drawer__subtotal">
        <span>Subtotal</span>
        <span id="CartDrawerSubtotal">{{ cart.total_price | money }}</span>
      </div>
      <p style="font-size:0.85rem;color:#64748b;margin-bottom:1rem;">Taxes, discounts, and shipping calculated at checkout</p>
      <form action="{{ routes.cart_url }}" method="post" id="CartDrawerCheckoutForm">
        <input type="hidden" name="discount" id="CartDrawerHiddenDiscount" value="">
        <button type="submit" name="checkout" class="btn btn-primary btn-full">Proceed to Checkout</button>
      </form>
      <div style="text-align:center;margin-top:0.75rem;">
        <a href="{{ routes.cart_url }}" style="font-size:0.9rem;text-decoration:underline;">View full cart</a>
      </div>
    </div>
  </div>
</div>

