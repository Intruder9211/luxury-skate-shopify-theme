{% comment %}
  Seed Jewelry Off-Canvas Navigation Drawer (Opens from Left)
  Explicitly mapped to your 11 store catalog categories from CSV:
  - Complete Skateboards
  - Cruiser Skateboards
  - Skateboard Decks
  - Wheels
  - Bearings
  - Trucks
  - Grip Tape & Hardware
  - Tools & Accessories
  - Protective Gear
  - Apparel
  - Maintenance & Storage
{% endcomment %}

<div id="NavDrawer" class="nav-drawer" aria-modal="true" role="dialog" aria-label="Navigation Menu">
  <div class="nav-drawer__overlay" data-nav-drawer-close></div>
  <div class="nav-drawer__panel">
    <!-- Close Button -->
    <div class="nav-drawer__top">
      <button type="button" class="nav-drawer__close" data-nav-drawer-close aria-label="Close menu">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="22" height="22">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Multi-Column Links Area -->
    <div class="nav-drawer__content">
      <div class="nav-drawer__columns">
        <!-- Column 1: Boards & Hardware Categories -->
        <div class="nav-drawer__col">
          <div class="nav-drawer__col-title">
            Skateboards & Parts
          </div>
          <ul class="nav-drawer__list">
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Complete+Skateboard" class="nav-drawer__link">Complete Skateboards</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Cruiser+Skateboard" class="nav-drawer__link">Cruiser Skateboards</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Skateboard+Deck" class="nav-drawer__link">Skateboard Decks</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Skateboard+Wheels" class="nav-drawer__link">Wheels</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Skateboard+Bearings" class="nav-drawer__link">Bearings</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Skateboard+Trucks" class="nav-drawer__link">Trucks</a></li>
          </ul>

          <!-- Editorial & Support Quick Links -->
          <div class="nav-drawer__editorial-group">
            <span class="nav-drawer__group-label">EXPLORE & DISCOVER</span>
            <ul class="nav-drawer__editorial-list">
              <li>
                <a href="/pages/about-us" class="nav-drawer__editorial-link">
                  <span class="nav-drawer__editorial-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                  </span>
                  <span>About Us</span>
                </a>
              </li>
              <li>
                <a href="/blogs/news" class="nav-drawer__editorial-link">
                  <span class="nav-drawer__editorial-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                    </svg>
                  </span>
                  <span>The Street Journal</span>
                </a>
              </li>
              <li>
                <a href="/products/digital-gift-card" class="nav-drawer__editorial-link nav-drawer__editorial-link--highlight">
                  <span class="nav-drawer__editorial-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 00-2 2v6a2 2 0 002 2h14a2 2 0 002-2v-6a2 2 0 00-2-2H5z"></path>
                    </svg>
                  </span>
                  <span>StreetRide Gift Card</span>
                </a>
              </li>
              <li>
                <a href="/pages/contact" class="nav-drawer__editorial-link">
                  <span class="nav-drawer__editorial-icon">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                    </svg>
                  </span>
                  <span>Contact Concierge</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Column 2: Gear, Apparel & Maintenance Categories -->
        <div class="nav-drawer__col">
          <div class="nav-drawer__col-title">
            Gear & Accessories
          </div>
          <ul class="nav-drawer__list">
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Grip+Tape&filter.p.product_type=Skateboard+Hardware" class="nav-drawer__link">Grip Tape & Hardware</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Skateboard+Tools&filter.p.product_type=Skateboard+Accessories" class="nav-drawer__link">Tools & Accessories</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Protective+Gear" class="nav-drawer__link">Protective Gear</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Skate+Apparel" class="nav-drawer__link">Apparel</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?filter.p.product_type=Skateboard+Maintenance&filter.p.product_type=Skateboard+Storage&filter.p.product_type=Skateboard+Parts&filter.p.product_type=Skateboard+Bags" class="nav-drawer__link">Maintenance & Storage</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="nav-drawer__link active-pill">View All 64 Products</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Localization & Policy Links -->
    <div class="nav-drawer__footer">
      <div class="nav-drawer__localization">
        <span>Deliver to: <strong>{{ localization.country.name }} ({{ localization.country.currency.iso_code }}) &bull; {{ localization.language.endonym_name | capitalize }}</strong> &or;</span>
      </div>

      <div class="nav-drawer__legal">
        {% for policy in shop.policies %}
          <a href="{{ policy.url }}">{{ policy.title }}</a>
        {% else %}
          <a href="{{ routes.root_url }}">Store Policies</a>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
