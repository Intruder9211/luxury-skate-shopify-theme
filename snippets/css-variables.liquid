{% style %}
  {% # Fonts %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', '500' | font_face: font_display: 'swap' }}

  {% if settings.type_heading_font %}
    {{ settings.type_heading_font | font_face: font_display: 'swap' }}
    {{ settings.type_heading_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% endif %}

  :root {
    --font-heading-family: {% if settings.type_heading_font %}{{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }}{% else %}Georgia, "Times New Roman", serif{% endif %};
    --font-primary--family: {{ settings.type_primary_font.family | default: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif' }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style | default: 'normal' }};
    --font-primary--weight: {{ settings.type_primary_font.weight | default: 400 }};
    
    --page-width: {{ settings.max_page_width | default: '1360px' }};
    --page-margin: {{ settings.min_page_margin | default: 32 }}px;
    
    /* Seed Jewelry refined palette */
    --color-background: {{ settings.background_color | default: '#FBFBF9' }};
    --color-foreground: {{ settings.foreground_color | default: '#141414' }};
    --color-gold: {{ settings.primary_accent | default: '#B89C72' }};
    --color-secondary-bg: {{ settings.secondary_accent | default: '#F4F3EF' }};
    --color-border: {{ settings.border_color | default: '#E8E6E1' }};
    --color-sale: {{ settings.sale_badge_color | default: '#B89C72' }};
    
    --border-radius: {{ settings.border_radius | default: 2 }}px;
    --border-radius-sm: 2px;
    
    --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    --transition-smooth: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
{% endstyle %}