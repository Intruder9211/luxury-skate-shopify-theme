<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load critical & theme CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
  </head>

  <body>
    <a class="skip-to-content visually-hidden" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.enable_cart_drawer %}
      {% render 'cart-drawer' %}
    {% endif %}

    {% render 'wishlist-drawer' %}
    {% render 'localization-modal' %}
  </body>
</html>
